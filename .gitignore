# secrets - never commit
.env

# your own default company list for download_script.py (see companies.example.txt)
companies.txt

# generated data artifacts (large; regenerate with download_script.py)
executive_interviews.json
executive_interviews.csv
executive_interviews_by_year.csv
interviews_by_year_company.csv

# saved Search & Export query results (generated by viewer_server.py at runtime)
queries/

# coding subsystem's SQLite store (segments, codebook, codes, predictions) --
# regenerate segments with scripts/build_segments.py; the researcher's actual
# codebook/codes live only here and in this Dropbox folder's own sync, not git
coding.db
coding.db-wal
coding.db-shm

# safety-net backups made by scripts/migrate_field_names.py before it rewrites
# queries/*.json or coding.db in place -- keep locally, never commit
coding.db.backup_*
queries_backup_*/

# unrelated research material kept in this workspace, not part of the dashboard
Archive/
Examples/
AH analysis/
Notes/
API Notes.docx
Video Data.txt
ceo_transcript_summary.ipynb

# real, researcher-provided example files used to design the importers --
# not synthetic, not meant to be redistributed
data examples/

# python
__pycache__/
*.pyc

# stray editor/tool cruft, not part of the dashboard
.Rhistory

# researcher-facing codebook/codes export (regenerate any time via
# coding_store.export_codebook / GET /api/export/codebook)
exports/

# local machine state: which project folders this researcher has opened
# (project_registry.py) -- not shared/portable, regenerated on first run
projects_registry.json
