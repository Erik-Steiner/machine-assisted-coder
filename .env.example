API_KEY=your-api-key-here
BASE_URL=https://example.com

# Optional: tags codes you apply in the Coding/Review tabs with this name
# (coding_store/codes.py's `coder` field). Defaults to "researcher" if unset.
# CODER_NAME=your-name-here

# Optional: run a second, independent research project from this same clone by
# pointing queries/, exports/, and coding.db at a different folder. Defaults to
# this repo's own folder if unset. See paths.py.
# PROJECT_DIR=C:/path/to/other/project
